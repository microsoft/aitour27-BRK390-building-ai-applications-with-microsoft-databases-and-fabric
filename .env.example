# Fabric SQL and Eventhouse endpoints
FABRIC_SQL_SERVER=
FABRIC_SQL_DATABASE=
FABRIC_KUSTO_CLUSTER=
FABRIC_KUSTO_DATABASE=

# Microsoft Entra API validation and browser sign-in
ENTRA_TENANT_ID=
ENTRA_API_AUDIENCE=
ENTRA_CLIENT_ID=
ENTRA_API_SCOPE=

# User-assigned workload identity, only when needed. Prefer managed identity.
AZURE_CLIENT_ID=
AZURE_TENANT_ID=

PORT=3903

# Operator deployment context; never commit populated environment files.
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZURE_FUNCTION_APP=

# Standalone Azure Function workflow (separate from Fabric SQL above).
ACT3_SQL_SERVER=
ACT3_SQL_DATABASE=
ACT3_EMBEDDING_ENDPOINT=
ACT3_EMBEDDING_DEPLOYMENT=
ACT3_EMBEDDING_PROFILE=
ACT3_GUIDANCE_MAX_DISTANCE=
ACT3_COSMOS_ENDPOINT=
ACT3_COSMOS_DATABASE=
ACT3_COSMOS_CONTAINER=
ACT3_STAFFING_CASE_ID=
ACT3_REDIRECT_URI=

# Set true only for a specifically reviewed cloud mutation; never needed by tests.
CALDOVA_ALLOW_CLOUD_WRITES=false
CALDOVA_SYNTHETIC_SOURCE_CONFIRMED=false